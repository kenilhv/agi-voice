{
  "name": "@voicefuzz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@voicefuzz/contracts": "workspace:*",
    "@voicefuzz/inworld-adapter": "workspace:*",
    "@voicefuzz/mock-adapter": "workspace:*",
    "@voicefuzz/test-engine": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
