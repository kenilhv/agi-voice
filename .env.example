# API
PORT=8787
HOST=0.0.0.0
ARTIFACT_DIR=./data/artifacts
DATABASE_PATH=./data/voicefuzz.json

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_DEMO_MODE=true

# Target selection for demo runs: vulnerable | guarded
DEFAULT_TARGET_VARIANT=vulnerable

# Inworld (server-side only; leave disabled for the network-independent demo)
INWORLD_API_KEY=
VOICEFUZZ_USE_INWORLD=false
INWORLD_BASE_URL=https://api.inworld.ai
INWORLD_CALLER_VOICE_ID=Ashley
INWORLD_AGENT_VOICE_ID=Dennis
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_STT_MODEL=inworld/inworld-stt-1
INWORLD_LLM_MODEL=auto
INWORLD_TIMEOUT_MS=20000
INWORLD_REALTIME_PACING=true
